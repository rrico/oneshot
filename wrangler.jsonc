{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oneshot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // SPA + API in one Worker. Static files are served directly; the Worker only
  // runs first for API routes and share links. Unknown paths fall back to index.html.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/g/*"]
  },

  // database_id is filled in automatically on first `wrangler deploy`
  // (or paste the id from `wrangler d1 create oneshot`).
  "d1_databases": [
    { "binding": "DB", "database_name": "oneshot", "migrations_dir": "migrations" }
  ],

  // Result submissions: 10 per IP per minute.
  "ratelimits": [
    { "name": "RESULTS_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],

  // Daily cleanup of expired games and their plays.
  "triggers": { "crons": ["17 4 * * *"] }
}
